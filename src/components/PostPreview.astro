---
import { Image } from 'astro:assets'
import { type CollectionEntry, type CollectionKey, render } from 'astro:content'

import { cn } from 'astro-pure/utils'
import { Button, FormattedDate, Icon } from 'astro-pure/user'

type Props<T extends CollectionKey> = {
  post: CollectionEntry<T>
  detailed?: boolean
  class?: string
}

const { post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
---

<article
  class={cn('post-preview relative', className)}
  style={detailed &&
    data.heroImage?.color &&
    `--preview-highlight:color-mix(in srgb,${data.heroImage.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)));
    --preview-highlight-bg:hsl(from ${data.heroImage.color} h s l/20%)`}
>
  {/* Outer is <div> (NOT <a>) to avoid invalid nested <a> tags.
      Title is wrapped in <a> with stretched-link pattern so the whole card is clickable. */}
  <div
    class={cn(
      'block w-full relative group rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted hover:text-primary',
      detailed && 'max-sm:px-4 sm:py-5',
      detailed && data.heroImage && 'max-md:pt-24'
    )}
  >
    {
      detailed && data.heroImage && (
        <Image
          alt={data.heroImage.alt || data.title}
          class='cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70 md:h-full md:w-3/5'
          loading='eager'
          {...data.heroImage}
        />
      )
    }
    <div
      class={cn('relative flex flex-col gap-1', !detailed && 'sm:flex-row sm:items-center')}
    >
      {/* Row: date + title + arrow — always visible */}
      <div class={cn('flex items-baseline gap-2', !detailed && 'sm:items-center')}>
        <FormattedDate class='text-xs shrink-0 text-muted-foreground' date={postDate} />
        <div class='flex justify-between flex-grow min-w-0'>
          <a
            href={`/blog/${id}`}
            data-astro-prefetch
            class={cn(
              'stretched-link font-medium no-underline text-inherit',
              !detailed && ''
            )}
          >
            {data.draft && <span class='text-red-500'>(Draft) </span>}
            {data.title}
          </a>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='16'
            height='16'
            viewBox='0 0 24 24'
            fill='none'
            stroke-width='2.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='preview-redirect my-1 shrink-0 stroke-muted-foreground group-hover:stroke-primary'
          ><line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
          ></line><polyline
            points='12 5 19 12 12 19'
            class='translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1'
          ></polyline></svg
          >
        </div>
      </div>

      {/* detailed metadata — flows flat below title, no indent */}
      {
        detailed && (
          <>
            {data.description && (
              <p
                class={cn(
                  'line-clamp-2 text-sm text-muted-foreground sm:line-clamp-3',
                  data.heroImage && 'sm:me-24'
                )}
              >
                {data.description}
              </p>
            )}
            {/* single-value metadata: category + reading time + language, one row */}
            <div class='flex flex-wrap items-center gap-2'>
              {data.category && (
                <a
                  href={`/categories/${data.category}`}
                  class='relative z-[2] inline-flex items-center gap-1 rounded-full border border-primary/30 bg-primary/5 px-2.5 py-0.5 text-xs font-medium text-primary transition-colors hover:bg-primary/10'
                  data-pagefind-filter='category'
                >
                  <Icon name='list' class='size-3.5' />
                  {data.category}
                </a>
              )}
              <span class='flex items-center gap-1 text-xs text-muted-foreground'>
                <Icon name='time' class='size-3.5' />
                {remarkPluginFrontmatter.minutesRead}
              </span>
              {data.language && (
                <span class='flex items-center gap-1 text-xs text-muted-foreground'>
                  <Icon name='earth' class='size-3.5' />
                  {data.language}
                </span>
              )}
            </div>
            {/* multi-value labels: tags, own row */}
            {data.tags.length > 0 && (
              <ul class='tag-list flex flex-wrap gap-1.5'>
                {data.tags.map((tag: string) => (
                  <li>
                    <Button
                      as='a'
                      title={tag}
                      href={`/tags/${tag}`}
                      variant='pill'
                      class='relative z-[2]'
                    />
                  </li>
                ))}
              </ul>
            )}
          </>
        )
      }
    </div>
  </div>

  <style>
    /* Stretched link: the title <a> gets a ::after that covers the entire card,
       so clicking anywhere on the card navigates to the post.
       Other internal links (category, tags) use z-[2] to stay clickable on top. */
    .stretched-link::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    .post-preview {
      --preview-highlight-final: var( --preview-highlight, hsl(var(--primary) / var(--un-text-opacity, 1))
      );
    }
    .post-preview:hover {
      & > div,
      & .tag-list a {
        background-color: var( --preview-highlight-bg, hsl(var(--muted) / var(--un-bg-opacity, 1))) !important;
      }
      & > div,
      & .tag-list a:hover {
        color: var(--preview-highlight-final) !important;
      }
      & > div .preview-redirect {
        stroke: var(--preview-highlight-final) !important;
      }
    }
    .cover-image {
      -webkit-mask-image: -webkit-linear-gradient(left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      mask-image: linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
    }

    @media (max-width: 768px) {
      .cover-image {
        -webkit-mask-image: -webkit-linear-gradient(bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
        mask-image: linear-gradient(to top, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);
      }
    }
  </style>
</article>
